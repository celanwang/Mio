# Mio 环境变量模板：复制为 .env 并填写真实值（.env 不提交 Git）
# DashScope API key（必填，否则无法聊天）
DASHSCOPE_API_KEY=sk-xxxx

# 麦当劳 MCP：填了真实 token 后把 enabled 改为 true
MCD_MCP_ENABLED=false
MCD_MCP_TOKEN=

# 微博官方 MCP：OAuth 按需授权，无静态 token；授权凭证保存在本机 .weibo/auth.json
# WEIBO_MCP_ENABLED=true

# 腾讯出行打车：填了真实 token 后即可使用（获取方式见 skills/tencent-ride 技能 quick-start 说明）
TENCENT_RIDE_ENABLED=true
TENCENT_RIDE_TOKEN=
# 可选：Python 解释器路径（默认 python）/ 常住城市（留空则打车时主动询问）
# TENCENT_RIDE_PYTHON=python
# TENCENT_RIDE_CITY=

# 可选：DashScope 地域地址 / 代理
# DASHSCOPE_BASE_URL=
# DASHSCOPE_PROXY_HOST=127.0.0.1
# DASHSCOPE_PROXY_PORT=7890

# 可选：轻量模型，配置 Jev 后简单请求由 Jev 路由到该模型（默认 qwen3.8-flash）
# DASHSCOPE_FAST_MODEL=qwen3.8-flash
# 可选：标准模型，Jev 路由的中间档，点餐/打车/微博等工具流程走该模型（默认 qwen3.7-plus，qwen3.8 系列无 plus 档）
# DASHSCOPE_PLUS_MODEL=qwen3.7-plus
# 可选：主模型（默认 qwen3.8-max；账号无该模型权限时 DashScope 返回 404，
# 备选 qwen-plus——注意 qwen-max 输入上限 30k，微博 75 个工具注册后会超限 400，不适合当主模型）
# DASHSCOPE_MODEL=qwen3.8-max

# 可选：Jev 决策审核（TypeSafe AI）。填写后写操作由 Jev 先审，通过自动执行，不通过转人工；
# 留空则写操作一律转人工确认。
TYPESAFE_API_KEY=
# JEV_ENABLED=true
# JEV_AUTO_APPROVE_THRESHOLD=0.8

# 可选：是否自动提炼画像（默认 true）
# MIO_DISTILLER_ENABLED=true
# 可选：是否从事件日志统计习惯并生成自动化提议（默认 true；提议需在面板批准才生效）
# MIO_HABIT_DETECTOR_ENABLED=true
# 可选：画像注入相关性过滤（默认 true；false 回退为全量注入）/ 单次注入条目数上限（默认 30）
# MIO_INJECT_FILTER_ENABLED=true
# MIO_INJECT_MAX_ENTRIES=30
# 可选：规则未命中的领域页由轻量模型二次判定相关性（默认 true；超时/失败倒向不注入）
# MIO_INJECT_LLM_FILTER_ENABLED=true
# 可选：画像页向量召回（默认 true）/ 余弦相似度阈值（默认 0.35，已用真实 embedding 数据校准）
# MIO_INJECT_VECTOR_ENABLED=true
# MIO_INJECT_VECTOR_MIN_SCORE=0.35
# 可选：episode 情景回忆检索（默认 true；embedding 不可用时自动降级不影响对话）
# DASHSCOPE_EMBEDDING_MODEL=text-embedding-v4
# MIO_RAG_ENABLED=true
# MIO_RAG_TOP_K=3
# MIO_RAG_MIN_SCORE=0.6

# 必填：记忆存储（唯一后端，PostgreSQL + pgvector）连接信息，库需启用 vector 扩展。
# MIO_PG_JDBC_URL=jdbc:postgresql://主机:5432/mio
# MIO_PG_USERNAME=
# MIO_PG_PASSWORD=

# 可选：短期记忆 Redis（会话上下文/去重/缓存）。留空则回退进程内存（重启丢会话）。
# MIO_REDIS_HOST=
# MIO_REDIS_PORT=6379
# MIO_REDIS_PASSWORD=

# 多 Agent 受控预览：主助手按能力注册表委派餐饮、出行、微博任务。
# 默认关闭；开启需要 PG 协作表可读写，不会在存储故障时降级执行。
MIO_MULTI_AGENT_ENABLED=false
# MIO_MULTI_AGENT_MAX_TASKS=16
# MIO_MULTI_AGENT_MAX_MODEL_CALLS=40
# MIO_MULTI_AGENT_MAX_TOOL_CALLS=80
# MIO_MULTI_AGENT_MAX_TASK_CALLS=12
# MIO_MULTI_AGENT_MAX_TOKENS=80000
# MIO_MULTI_AGENT_MAX_CONTEXT_CHARACTERS=100000
# MIO_MULTI_AGENT_TIMEOUT_MS=150000
