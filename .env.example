# Mio 环境变量模板：复制为 .env 并填写真实值（.env 不提交 Git）
# DashScope API key（必填，否则无法聊天）
DASHSCOPE_API_KEY=sk-xxxx

# 麦当劳 MCP：填了真实 token 后把 enabled 改为 true
MCD_MCP_ENABLED=false
MCD_MCP_TOKEN=

# 可选：DashScope 地域地址 / 代理
# DASHSCOPE_BASE_URL=
# DASHSCOPE_PROXY_HOST=127.0.0.1
# DASHSCOPE_PROXY_PORT=7890

# 可选：轻量模型，配置 Jev 后简单请求由 Jev 路由到该模型（默认 qwen-flash）
# DASHSCOPE_FAST_MODEL=qwen-flash

# 可选：Jev 决策审核（TypeSafe AI）。填写后写操作由 Jev 先审，通过自动执行，不通过转人工；
# 留空则写操作一律转人工确认。
TYPESAFE_API_KEY=
# JEV_ENABLED=true
# JEV_AUTO_APPROVE_THRESHOLD=0.8

# 可选：用户画像与记忆数据目录（默认 ~/.mio）/ 是否自动提炼画像（默认 true）
# MIO_DATA_DIR=~/.mio
# MIO_DISTILLER_ENABLED=true
